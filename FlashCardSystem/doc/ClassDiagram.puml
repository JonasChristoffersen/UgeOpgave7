@startuml
'https://plantuml.com/class-diagram

class Main

class FileIO {
    - Scanner
    - File
    + readData()
    + writeData()
}

class FlashCard {
    - String term
    - String description
    + flipCard()
}

Deck *-- FlashCard: uses
class Deck {
    - ArrayList<FlashCard>
    + FlashCard getNextCard()
    + void displayNextCard()
    + addCard()
    + removeCard()
}

@enduml