@startuml
'https://plantuml.com/class-diagram

Game *-- Player: has
Game *-- TextUI: uses

class Main {
    + {static} main()
}

class Game {
    - String name
    - ArrayList<Player> Players
    + Game(String)
    + void registerPlayers()
    + void endGame()
}

class TextUI {
    - Scanner scan
    + int PromptNumeric(String)
    + String promptText(String)
    + void displayList(ArrayList<String>, String, boolean)
    + ArrayList<String> promptChoice(ArrayList<String>, int, String)
}

class Player {
    - String name
    - int score
    + Player(String)
    + Player(String, int)
    + String toString()
    + setScore()
    + addScore()
    + getName()
    + getScore()
}

@enduml